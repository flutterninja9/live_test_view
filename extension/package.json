{
  "name": "live-test-view",
  "displayName": "Live Test View",
  "description": "Watch Flutter widget tests render live as they run.",
  "version": "0.1.0",
  "publisher": "anirudh-singh",
  "license": "MIT",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Testing"],
  "activationEvents": ["onLanguage:dart"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      { "command": "liveTestView.runTest", "title": "Live Test View: Run Test" }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
